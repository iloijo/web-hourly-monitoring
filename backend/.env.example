# Copy to backend/.env and fill in. backend/.env is git-ignored.

# TwoDb (measHy4g) - LAN first, then Cloudflare tunnel on localhost:5434
TWODB_LAN_HOST=192.168.1.231
TWODB_LAN_PORT=5432
TWODB_TUNNEL_HOST=127.0.0.1
TWODB_TUNNEL_PORT=5434
TWODB_DB=twodb
TWODB_USER=
TWODB_PASS=

# OneDb (measDy4g, measBdbh4g, measDy5g, measDy2g, CellListRCI, ...)
ONEDB_HOST=187.127.124.130
ONEDB_PORT=5432
ONEDB_DB=onedb
ONEDB_USER=
ONEDB_PASS=
# Cluster Monitoring: role with write access to netpulse_cluster* tables
ONEDB_RW_USER=
ONEDB_RW_PASS=

# First SuperAdmin account. Used only once, to create it when the user database
# (backend/data/netpulse_auth.sqlite3) is still empty. Afterwards manage users from
# the Administrasi page; changing these values no longer changes the login.
# Leave empty (and the database empty) to run without login.
DASHBOARD_USER=
DASHBOARD_PASS=
# Optional: another location for the user database file
AUTH_DB_PATH=
